{
  "name": "eneredge",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "e2e"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter './apps/*' dev",
    "build": "bun run --filter @eneredge/web build",
    "start": "bun run --parallel --filter './apps/*' start",
    "test": "bun test",
    "e2e": "bun e2e/run.ts",
    "check": "bun run --filter '*' check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun packages/db/src/migrate.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "typescript": "^7"
  }
}
