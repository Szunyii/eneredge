# Copy to .env and fill in AUTH_SECRET. Bun loads .env automatically.
NODE_ENV=development
# The API listens here. The browser never calls it directly: the web app forwards /api/* to it.
PORT=3001
# The public address of the web app (mail links and cookies are tied to it).
APP_URL=http://localhost:3000

# Development database from compose.yaml (docker compose up -d --wait db)
DATABASE_URL=postgres://eneredge:eneredge@localhost:54329/eneredge

# At least 32 characters. Generate one with: openssl rand -base64 32
AUTH_SECRET=

# log: prints mails to the console · file: appends JSON lines to MAIL_FILE · smtp: sends them
MAIL_TRANSPORT=log
MAIL_FROM=EnerEdge <no-reply@eneredge.tech>
MAIL_FILE=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=

# Comma-separated e-mail addresses of platform admins
PLATFORM_ADMIN_EMAILS=

# open: anyone can sign up · allowlist: only allowlisted or invited addresses and platform admins
SIGNUP_MODE=open
